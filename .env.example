# ============================================================================
# LLM & GigaChat Configuration
# ============================================================================

# Способ 1: Прямой access token (Bearer токен, если выдан организаторами)
GIGACHAT_ACCESS_TOKEN=

# Способ 2: Ключ авторизации Client Credentials (Base64 строка)
# Если указан GIGACHAT_CREDENTIALS, клиент сам обращается к OAuth для получения токена
GIGACHAT_CREDENTIALS=

# Область доступа: GIGACHAT_API_PERS (физлица) или GIGACHAT_API_CORP (корпоративные клиенты)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель GigaChat: GigaChat-3-Ultra (новейшая флагманская Ультра), GigaChat-2-Max, GigaChat-Max
GIGACHAT_MODEL=GigaChat-3-Ultra

# Базовый URL API GigaChat
GIGACHAT_BASE_URL=https://api.giga.chat/v1

# Проверка SSL сертификатов (серверы Сбера используют сертификаты Минцифры)
# false — отключить проверку (рекомендуется для избежания SSLCertVerificationError)
GIGACHAT_VERIFY_SSL=false

# Путь к кастомному сертификату CA (опционально, если GIGACHAT_VERIFY_SSL=true)
# GIGACHAT_CA_BUNDLE_FILE=

# Эмбеддинг модель
GIGACHAT_EMBEDDINGS_MODEL=Embeddings
